digraph BlockMaxPruning {
  graph [
    rankdir=TB,
    bgcolor="#F8FAFC",
    pad="0.35",
    nodesep="0.34",
    ranksep="0.55",
    splines=ortho,
    fontname="Noto Sans CJK SC",
    fontsize=13,
    fontcolor="#334155",
    label="Block-Max：局部上界低于竞争阈值时整块跳过",
    labelloc=t,
    labeljust=l
  ];

  node [
    shape=rect,
    style="rounded,filled",
    fontname="Noto Sans CJK SC",
    fontsize=10,
    color="#CBD5E1",
    fillcolor="#FFFFFF",
    fontcolor="#172033",
    penwidth=1.2,
    margin="0.15,0.10"
  ];

  edge [
    color="#64748B",
    penwidth=1.4,
    arrowsize=0.7,
    fontname="Noto Sans CJK SC",
    fontsize=9,
    fontcolor="#475569"
  ];

  threshold [
    shape=note,
    fillcolor="#FEF3C7",
    color="#F59E0B",
    penwidth=1.6,
    label=<
      <B>Top-K 当前阈值</B><BR/>
      <FONT FACE="monospace" POINT-SIZE="11">minCompetitiveScore = 3.0</FONT>
    >
  ];

  subgraph cluster_low {
    label="docID 0..127";
    style="rounded,filled";
    color="#BFDBFE";
    fillcolor="#EFF6FF";
    margin=14;

    low_a [label=<数据库<BR/><FONT POINT-SIZE="9">block max = 0.8</FONT>>];
    low_b [label=<索引<BR/><FONT POINT-SIZE="9">block max = 0.6</FONT>>];
    low_c [label=<优化<BR/><FONT POINT-SIZE="9">block max = 0.4</FONT>>];
    low_sum [
      fillcolor="#FEE2E2",
      color="#F87171",
      label=<
        <B>合计上界 = 1.8</B><BR/>
        <FONT POINT-SIZE="9">1.8 &lt; 3.0</FONT>
      >
    ];

    { rank=same; low_a; low_b; low_c; }
    low_a -> low_sum;
    low_b -> low_sum;
    low_c -> low_sum;
  }

  skip [
    fillcolor="#FEE2E2",
    color="#EF4444",
    penwidth=1.6,
    label=<
      <B>整块跳过</B><BR/>
      <FONT POINT-SIZE="9">不解码 freq / norms，不做精确 BM25</FONT>
    >
  ];

  subgraph cluster_high {
    label="docID 128..255";
    style="rounded,filled";
    color="#C4B5FD";
    fillcolor="#F5F3FF";
    margin=14;

    high_a [label=<数据库<BR/><FONT POINT-SIZE="9">block max = 1.9</FONT>>];
    high_b [label=<索引<BR/><FONT POINT-SIZE="9">block max = 1.1</FONT>>];
    high_c [label=<优化<BR/><FONT POINT-SIZE="9">block max = 0.7</FONT>>];
    high_sum [
      fillcolor="#D1FAE5",
      color="#34D399",
      label=<
        <B>合计上界 = 3.7</B><BR/>
        <FONT POINT-SIZE="9">3.7 ≥ 3.0</FONT>
      >
    ];

    { rank=same; high_a; high_b; high_c; }
    high_a -> high_sum;
    high_b -> high_sum;
    high_c -> high_sum;
  }

  evaluate [
    fillcolor="#D1FAE5",
    color="#10B981",
    penwidth=1.6,
    label=<
      <B>进入候选调度</B><BR/>
      <FONT POINT-SIZE="9">再由 WAND / MAXSCORE 决定精确评分</FONT>
    >
  ];

  threshold -> low_sum [style=dashed, xlabel="比较"];
  threshold -> high_sum [style=dashed, xlabel="比较"];
  low_sum -> skip [color="#EF4444"];
  high_sum -> evaluate [color="#10B981"];
}
