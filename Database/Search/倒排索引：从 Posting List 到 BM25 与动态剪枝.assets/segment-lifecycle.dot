digraph SegmentLifecycle {
  graph [
    rankdir=LR,
    bgcolor="#F8FAFC",
    pad="0.35",
    nodesep="0.42",
    ranksep="0.78",
    splines=ortho,
    compound=true,
    fontname="Noto Sans CJK SC",
    fontsize=13,
    fontcolor="#334155",
    label="Lucene / Elasticsearch：不可变 Segment 的近实时写入",
    labelloc=t,
    labeljust=l
  ];

  node [
    shape=rect,
    style="rounded,filled",
    fontname="Noto Sans CJK SC",
    fontsize=11,
    color="#CBD5E1",
    fillcolor="#FFFFFF",
    fontcolor="#172033",
    penwidth=1.2,
    margin="0.16,0.10"
  ];

  edge [
    color="#64748B",
    penwidth=1.4,
    arrowsize=0.7,
    fontname="Noto Sans CJK SC",
    fontsize=9,
    fontcolor="#475569"
  ];

  write [
    fillcolor="#DBEAFE",
    color="#60A5FA",
    penwidth=1.6,
    label=<
      <B>新增 / 更新文档</B><BR/>
      <FONT POINT-SIZE="9" COLOR="#475569">一次写入分成可见性与持久性两条路径</FONT>
    >
  ];

  subgraph cluster_recovery {
    label="持久性（Elasticsearch）";
    style="rounded,filled";
    color="#FDE68A";
    fillcolor="#FFFBEB";
    margin=16;

    translog [
      fillcolor="#FEF3C7",
      color="#F59E0B",
      label=<
        <B>Translog</B><BR/>
        <FONT POINT-SIZE="9" COLOR="#475569">提交点前的崩溃恢复</FONT>
      >
    ];
    commit [
      label=<
        <B>Flush / Commit</B><BR/>
        <FONT POINT-SIZE="9" COLOR="#64748B">fsync segment，推进提交点</FONT>
      >
    ];

    translog -> commit [xlabel="持久化"];
  }

  subgraph cluster_visibility {
    label="搜索可见性";
    style="rounded,filled";
    color="#BFDBFE";
    fillcolor="#EFF6FF";
    margin=16;

    buffer [
      label=<
        <B>Indexing Buffer</B><BR/>
        <FONT POINT-SIZE="9" COLOR="#64748B">内存中收集 term / posting</FONT>
      >
    ];
    refresh [
      fillcolor="#DBEAFE",
      color="#60A5FA",
      label=<
        <B>Refresh</B><BR/>
        <FONT POINT-SIZE="9" COLOR="#475569">发布新的搜索视图</FONT>
      >
    ];
    small [
      fillcolor="#EDE9FE",
      color="#A78BFA",
      label=<
        <B>多个不可变 Segment</B><BR/>
        <FONT POINT-SIZE="9" COLOR="#475569">S₀ · S₁ · S₂ + live-doc bitmap</FONT>
      >
    ];

    buffer -> refresh -> small;
  }

  query [
    fillcolor="#D1FAE5",
    color="#34D399",
    label=<
      <B>并行查询各 Segment</B><BR/>
      <FONT POINT-SIZE="9" COLOR="#475569">过滤删除项，再归并 Top-K</FONT>
    >
  ];

  merge [
    fillcolor="#FCE7F3",
    color="#F472B6",
    label=<
      <B>后台 Merge</B><BR/>
      <FONT POINT-SIZE="9" COLOR="#475569">重写 postings · 回收删除空间</FONT>
    >
  ];

  large [
    fillcolor="#D1FAE5",
    color="#34D399",
    penwidth=1.6,
    label=<
      <B>更大的 Segment</B><BR/>
      <FONT POINT-SIZE="9" COLOR="#475569">更少查询扇出，更高写放大</FONT>
    >
  ];

  write -> translog;
  write -> buffer;
  small -> query;
  small -> merge;
  merge -> large;
  large -> query [constraint=false];
  commit -> large [style=dashed, color="#94A3B8", xlabel="提交当前 segment 集合"];
}
