digraph PQADC {
  graph [
    rankdir=LR,
    bgcolor="#F8FAFC",
    pad="0.35",
    nodesep="0.4",
    ranksep="0.55",
    fontname="Noto Sans CJK SC",
    fontsize=13,
    fontcolor="#334155",
    label="PQ：切成 96 段，每段用 1 字节编号；查询时 96 次查表求和",
    labelloc=t,
    labeljust=l,
    newrank=true
  ];

  node [
    shape=rect,
    style="rounded,filled",
    fontname="Noto Sans CJK SC",
    fontsize=11,
    color="#CBD5E1",
    fillcolor="#FFFFFF",
    fontcolor="#172033",
    penwidth=1.2,
    margin="0.16,0.10"
  ];

  edge [
    color="#64748B",
    penwidth=1.3,
    arrowsize=0.7,
    fontname="Noto Sans CJK SC",
    fontsize=9,
    fontcolor="#475569"
  ];

  subgraph cluster_build {
    label="建库：编码一条向量";
    style="rounded,filled";
    color="#C4B5FD";
    fillcolor="#F5F3FF";
    margin=14;
    x [label=<
      <B>x：1536 维</B><BR/>
      <FONT POINT-SIZE="9" COLOR="#475569">切成 96 段，每段 16 维</FONT>
    >];
    cb [fillcolor="#EDE9FE", color="#A78BFA", label=<
      <B>每段一个码本</B><BR/>
      <FONT POINT-SIZE="9" COLOR="#475569">k-means 训出 256 个码字</FONT>
    >];
    code [fillcolor="#DDD6FE", color="#8B5CF6", label=<
      <B>码：96 字节</B><BR/>
      <FONT POINT-SIZE="9" COLOR="#475569">每段存最近码字的编号</FONT>
    >];
    x -> cb -> code;
  }

  subgraph cluster_query {
    label="查询：非对称距离（ADC）";
    style="rounded,filled";
    color="#A7F3D0";
    fillcolor="#ECFDF5";
    margin=14;
    q [label=<
      <B>q：保持原精度</B><BR/>
      <FONT POINT-SIZE="9" COLOR="#475569">同样切成 96 段</FONT>
    >];
    lut [fillcolor="#D1FAE5", color="#34D399", label=<
      <B>距离表 96 × 256</B><BR/>
      <FONT POINT-SIZE="9" COLOR="#475569">每段 q 到每个码字的距离，每次查询算一次</FONT>
    >];
    sum [fillcolor="#FEF3C7", color="#F59E0B", label=<
      <B>估计距离</B><BR/>
      <FONT POINT-SIZE="9" COLOR="#475569">按码查 96 次表，加起来</FONT>
    >];
    q -> lut -> sum;
  }

  code -> sum [style=dashed, label="候选的码"];
  { rank=same; x; q; }
}
