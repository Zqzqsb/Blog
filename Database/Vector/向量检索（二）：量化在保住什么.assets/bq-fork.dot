digraph BQFork {
  graph [
    rankdir=TB,
    bgcolor="#F8FAFC",
    pad="0.35",
    nodesep="0.5",
    ranksep="0.5",
    fontname="Noto Sans CJK SC",
    fontsize=13,
    fontcolor="#334155",
    label="裸 BQ 暴露的两个问题，和两条修法",
    labelloc=t,
    labeljust=l
  ];

  node [
    shape=rect,
    style="rounded,filled",
    fontname="Noto Sans CJK SC",
    fontsize=11,
    color="#CBD5E1",
    fillcolor="#FFFFFF",
    fontcolor="#172033",
    penwidth=1.2,
    margin="0.16,0.10"
  ];

  edge [
    color="#64748B",
    penwidth=1.3,
    arrowsize=0.7,
    fontname="Noto Sans CJK SC",
    fontsize=9,
    fontcolor="#475569"
  ];

  bq [fillcolor="#FEF3C7", color="#F59E0B", label=<
    <B>裸 BQ</B><BR/>
    <FONT POINT-SIZE="9" COLOR="#475569">每维只留符号位 · popcount 估相似度 · 32 倍压缩</FONT>
  >];

  p1 [fillcolor="#FEF2F2", color="#F87171", label=<
    <B>问题一：估计有偏</B><BR/>
    <FONT POINT-SIZE="9" COLOR="#475569">幅度全丢了，汉明距离和真实内积之间没有可靠的换算</FONT>
  >];
  p2 [fillcolor="#FEF2F2", color="#F87171", label=<
    <B>问题二：比特用得不均</B><BR/>
    <FONT POINT-SIZE="9" COLOR="#475569">各维信息量差别很大，每一位却只能存一样多</FONT>
  >];

  subgraph cluster_learn {
    label="修法一：向数据学";
    style="rounded,filled";
    color="#C4B5FD";
    fillcolor="#F5F3FF";
    margin=14;
    learn [fillcolor="#EDE9FE", color="#A78BFA", label=<
      <B>码本：PQ、OPQ、AQ / RQ、ScaNN</B><BR/>
      <FONT POINT-SIZE="9" COLOR="#475569">多维联合量化，码字从数据里训出来</FONT>
    >];
  }

  subgraph cluster_rotate {
    label="修法二：先把数据变均匀";
    style="rounded,filled";
    color="#A7F3D0";
    fillcolor="#ECFDF5";
    margin=14;
    rotate [fillcolor="#D1FAE5", color="#34D399", label=<
      <B>旋转：RaBitQ、TurboQuant</B><BR/>
      <FONT POINT-SIZE="9" COLOR="#475569">随机旋转后分布可预知，再配无偏估计器</FONT>
    >];
  }

  bq -> p1;
  bq -> p2;
  p1 -> learn [style=dashed, label="让码字贴近数据"];
  p2 -> learn [style=dashed];
  p1 -> rotate [label="无偏估计器"];
  p2 -> rotate [label="旋转摊平信息"];
}
