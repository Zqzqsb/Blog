digraph MemoryTiers {
  graph [
    rankdir=TB,
    bgcolor="#F8FAFC",
    pad="0.35",
    nodesep="0.6",
    ranksep="0.55",
    fontname="Noto Sans CJK SC",
    fontsize=13,
    fontcolor="#334155",
    label="内存装不下之后：粗信息留在内存导航，精确信息放到 SSD",
    labelloc=t,
    labeljust=l,
    newrank=true
  ];

  node [
    shape=rect,
    style="rounded,filled",
    fontname="Noto Sans CJK SC",
    fontsize=11,
    color="#CBD5E1",
    fillcolor="#FFFFFF",
    fontcolor="#172033",
    penwidth=1.2,
    margin="0.16,0.10",
    width=2.8
  ];

  edge [
    color="#64748B",
    penwidth=1.3,
    arrowsize=0.7,
    fontname="Noto Sans CJK SC",
    fontsize=9,
    fontcolor="#475569"
  ];

  subgraph cluster_diskann {
    label="DiskANN：在盘上走图";
    style="rounded,filled";
    color="#A7F3D0";
    fillcolor="#ECFDF5";
    margin=14;
    d_mem [fillcolor="#DBEAFE", color="#60A5FA", label=<
      <B>DRAM：全库 PQ 码</B><BR/>
      <FONT POINT-SIZE="9" COLOR="#475569">走图时用粗距离挑方向</FONT>
    >];
    d_ssd [fillcolor="#FEF3C7", color="#F59E0B", label=<
      <B>SSD：邻接表 + 全精度向量</B><BR/>
      <FONT POINT-SIZE="9" COLOR="#475569">按节点随机读，一次读出边和原向量</FONT>
    >];
    d_mem -> d_ssd [label="扩展哪个节点就读哪块"];
  }

  subgraph cluster_spann {
    label="SPANN：在盘上放倒排";
    style="rounded,filled";
    color="#C4B5FD";
    fillcolor="#F5F3FF";
    margin=14;
    s_mem [fillcolor="#DBEAFE", color="#60A5FA", label=<
      <B>DRAM：簇质心 + 质心上的索引</B><BR/>
      <FONT POINT-SIZE="9" COLOR="#475569">先决定读哪几个簇</FONT>
    >];
    s_ssd [fillcolor="#FEF3C7", color="#F59E0B", label=<
      <B>SSD：按簇连续存放的向量</B><BR/>
      <FONT POINT-SIZE="9" COLOR="#475569">边界点复制到多个簇，按簇顺序读</FONT>
    >];
    s_mem -> s_ssd [label="选中的簇整段读出"];
  }

  { rank=same; d_mem; s_mem; }
  { rank=same; d_ssd; s_ssd; }
}
