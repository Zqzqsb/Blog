digraph AssumptionChain {
  graph [
    rankdir=TB,
    bgcolor="#F8FAFC",
    pad="0.35",
    nodesep="0.5",
    ranksep="0.45",
    fontname="Noto Sans CJK SC",
    fontsize=13,
    fontcolor="#334155",
    label="五种赌法：每一种都从上一种的失效处出发",
    labelloc=t,
    labeljust=l
  ];

  node [
    shape=rect,
    style="rounded,filled",
    fontname="Noto Sans CJK SC",
    fontsize=11,
    color="#CBD5E1",
    fillcolor="#FFFFFF",
    fontcolor="#172033",
    penwidth=1.2,
    margin="0.18,0.10",
    width=3.6
  ];

  edge [
    color="#64748B",
    penwidth=1.3,
    arrowsize=0.7,
    fontname="Noto Sans CJK SC",
    fontsize=9,
    fontcolor="#B45309"
  ];

  tree [fillcolor="#EFF6FF", color="#60A5FA", label=<
    <B>按坐标切</B> · KD-tree<BR/>
    <FONT POINT-SIZE="9" COLOR="#475569">赌：近邻和查询落在同一个格子里</FONT>
  >];
  hash [fillcolor="#EFF6FF", color="#60A5FA", label=<
    <B>随机切</B> · LSH、随机投影树<BR/>
    <FONT POINT-SIZE="9" COLOR="#475569">赌：切很多次，近邻总有几次和查询同侧</FONT>
  >];
  ivf [fillcolor="#F5F3FF", color="#A78BFA", label=<
    <B>按数据切</B> · IVF<BR/>
    <FONT POINT-SIZE="9" COLOR="#475569">赌：近邻和查询属于同一个簇</FONT>
  >];
  graph_ [fillcolor="#ECFDF5", color="#34D399", label=<
    <B>不切，改连边</B> · HNSW、NSG、Vamana<BR/>
    <FONT POINT-SIZE="9" COLOR="#475569">赌：沿着「近的点」一路走，能走到近邻</FONT>
  >];
  disk [fillcolor="#FEF3C7", color="#F59E0B", label=<
    <B>分层存放</B> · DiskANN、SPANN<BR/>
    <FONT POINT-SIZE="9" COLOR="#475569">赌：粗信息够导航，精确信息只需读一小部分</FONT>
  >];

  tree -> hash [label="  高维下要打开几乎所有格子"];
  hash -> ivf [label="  切法不看数据，召回靠堆表数"];
  ivf -> graph_ [label="  近邻落在簇边界外就漏掉"];
  graph_ -> disk [label="  边表和向量放不进内存"];
}
