digraph ConnectorLayers {
  graph [
    rankdir=TB,
    bgcolor="#F8FAFC",
    pad="0.35",
    nodesep="0.4",
    ranksep="0.45",
    fontname="Noto Sans CJK SC",
    fontsize=13,
    fontcolor="#334155",
    label="connector 只写一次：API 与引擎之间隔着一层翻译",
    labelloc=t,
    labeljust=l
  ];

  node [
    shape=rect,
    style="rounded,filled",
    fontname="Noto Sans CJK SC",
    fontsize=11,
    color="#CBD5E1",
    fillcolor="#FFFFFF",
    fontcolor="#172033",
    penwidth=1.2,
    margin="0.16,0.08"
  ];

  edge [
    color="#64748B",
    penwidth=1.2,
    arrowsize=0.7,
    fontname="Noto Sans CJK SC",
    fontsize=9,
    fontcolor="#B45309"
  ];

  subgraph cluster_conn {
    label="Connector（100+ 个，各写一次）";
    fontsize=10;
    style="rounded,filled";
    fillcolor="#ECFDF5";
    color="#34D399";
    src [label=<<B>Source</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">MySQL-CDC · JDBC · Kafka · 文件 …</FONT>>];
    tf [label=<<B>Transform</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">改名 · 过滤 · 简单 SQL</FONT>>];
    snk [label=<<B>Sink</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">Iceberg · Doris · StarRocks · ES …</FONT>>];
  }

  api [fillcolor="#EFF6FF", color="#60A5FA", width=6.2, label=<
    <B>SeaTunnel Connector API</B><BR/>
    <FONT POINT-SIZE="9" COLOR="#475569">SourceSplitEnumerator / SourceReader · SinkWriter / SinkCommitter · SeaTunnelRow · CatalogTable</FONT>
  >];

  trans [width=6.2, label=<
    <B>翻译层</B><BR/>
    <FONT POINT-SIZE="9" COLOR="#475569">把 SeaTunnel 的 Source / Sink 包装成各引擎自己的接口</FONT>
  >];

  flink [label="Flink"];
  spark [label="Spark"];
  zeta [fillcolor="#FEF3C7", color="#F59E0B", label=<<B>Zeta</B><BR/><FONT POINT-SIZE="9" COLOR="#475569">为同步设计的自有引擎</FONT>>];

  src -> api;
  tf -> api;
  snk -> api;
  api -> trans;
  trans -> flink;
  trans -> spark;
  api -> zeta [label="  原生运行，不经翻译"];
}
